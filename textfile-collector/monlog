# checks node.toml for peers which can then be used later
# by other functions
function get_peers()
{
    NODE_TOML="/home/monad/monad-bft/config/node.toml"
    if [ -f "$NODE_TOML" ]; then
        grep -A 1 '^\[\[blocksync_override.peers\]\]' "$NODE_TOML" | grep '^secp256k1_pubkey' | perl -ne 'print "$1\n" if /secp256k1_pubkey\s*=\s*"(.+?)"/' > "$OVERRIDE_FILE"
    fi
}

# Fetches a single validator's info from GitHub API and caches it with timestamp
# Usage: fetch_single_validator <secp_key>
function fetch_single_validator()
{
    local secp_key="$1"
    local timestamp=$(date +%s)

    # Check if curl is installed
    if ! command -v curl &> /dev/null; then
        return 1
    fi

    # Remove old entry if it exists
    if [ -f "$VALIDATOR_CACHE_FILE" ]; then
        grep -v "^${secp_key}:" "$VALIDATOR_CACHE_FILE" > "${VALIDATOR_CACHE_FILE}.tmp" 2>/dev/null || true
        mv "${VALIDATOR_CACHE_FILE}.tmp" "$VALIDATOR_CACHE_FILE" 2>/dev/null || true
    fi

    # Fetch the validator JSON file
    local json_url="https://raw.githubusercontent.com/monad-developers/validator-info/main/${VALIDATOR_NETWORK}/${secp_key}.json"
    local validator_data=$(curl -s "$json_url" 2>/dev/null)

    if [ -n "$validator_data" ] && echo "$validator_data" | grep -q '"name"'; then
        # Extract the name and id fields from JSON
        local validator_name=$(echo "$validator_data" | grep '"name"' | head -1 | cut -d'"' -f4)
        local validator_id=$(echo "$validator_data" | grep '"id"' | head -1 | grep -oE '[0-9]+')

        if [ -n "$validator_name" ]; then
            # Append to cache file (secp_key:name:id:timestamp)
            echo "${secp_key}:${validator_name}:${validator_id}:${timestamp}" >> "$VALIDATOR_CACHE_FILE"
            return 0
        fi
    fi

    # Mark as not found to avoid repeated lookups (with timestamp)
    echo "${secp_key}:NOT_FOUND::${timestamp}" >> "$VALIDATOR_CACHE_FILE"
    return 1
}

# similar to is_override but decorates secp keys with validator names
# usage: ... | add_validator_names
# outputs: "string (validator_name)" if found, or "string" if not
# Only works if -n flag is set, otherwise passes through unchanged
function add_validator_names()
{
    # Check if flag is enabled, if not just pass through
    if [ "$SHOW_VALIDATOR_NAMES" != true ]; then
        cat
        return 0
    fi

    # Create cache file if it doesn't exist
    [ ! -f "$VALIDATOR_CACHE_FILE" ] && touch "$VALIDATOR_CACHE_FILE"

    while IFS= read -r line; do
        # Extract secp key from the line (66 hex characters)
        local secp_key=$(echo "$line" | grep -oE '[0-9a-fA-F]{66}' | head -1)

        if [ -n "$secp_key" ]; then
            # Look up the validator info in the cache (format: secp_key:name:id:timestamp)
            local cache_entry=$(grep "^${secp_key}:" "$VALIDATOR_CACHE_FILE" 2>/dev/null)
            local should_refresh=false

            if [ -n "$cache_entry" ]; then
                # Check if entry is stale (more than 1 hour old)
                local cached_timestamp=$(echo "$cache_entry" | cut -d: -f4)
                local current_time=$(date +%s)
                local age=$((current_time - cached_timestamp))

                if [ $age -gt 3600 ]; then
                    should_refresh=true
                fi
            else
                # Not in cache at all
                should_refresh=true
            fi

            # Fetch if needed
            if [ "$should_refresh" = true ]; then
                fetch_single_validator "$secp_key"
                # Re-read cache entry after fetch
                cache_entry=$(grep "^${secp_key}:" "$VALIDATOR_CACHE_FILE" 2>/dev/null)
            fi

            if [ -n "$cache_entry" ]; then
                local validator_name=$(echo "$cache_entry" | cut -d: -f2)
                local validator_id=$(echo "$cache_entry" | cut -d: -f3)

                # Skip if marked as not found
                if [ "$validator_name" = "NOT_FOUND" ]; then
                    echo "$line"
                    continue
                fi

                # Check if the name is just the key itself (no custom name)
                if [ "$validator_name" = "$secp_key" ]; then
                    # Name is the key, try to use id instead
                    if [ -n "$validator_id" ]; then
                        echo "$line (id: $validator_id)"
                    else
                        # No id either, no decoration
                        echo "$line"
                    fi
                else
                    # Has a proper custom name
                    echo "$line ($validator_name)"
                fi
            else
                # Still not found after fetch attempt, no decoration
                echo "$line"
            fi
        else
            echo "$line"
        fi
    done
}

# check if passed in strings are in the OVERRIDE_FILE
# usage: ... | is_override
# outputs: "string (blocksync override peer)" if found, or "string" if not
function is_override()
{
    if [ ! -f "$OVERRIDE_FILE" ] || [ ! -s "$OVERRIDE_FILE" ]; then
        # If no file, just echo the input as-is
        while IFS= read -r peer; do
            echo "$peer"
        done
        return 1
    fi

    while IFS= read -r peer; do
        if grep -qF "$peer" "$OVERRIDE_FILE"; then
            echo "$peer (blocksync override peer)"
        else
            echo "$peer"
        fi
    done
}

# quick simple checks for known issues
function quick_checks()
{
        if cat $INPUT_FILE | grep -qi "high qc too far ahead of block tree root";
        then
            print_error "❌ BFT too far ahead of Execution"
            echo -e "  ${DIM}→ most likely an execution issue${RESET}"
            echo -e "  ${DIM}→ maybe you need a reset + snapshot?${RESET}"
        fi
        if cat $INPUT_FILE | grep -qi "assertion *left == right* failed";
        then
            print_error "❌ 'left == right' failure"
            echo -e "  ${DIM}→ maybe you need a new validator file?${RESET}"
        fi
        if tail -10 $INPUT_FILE | grep exit; then
            print_error "❌ Process exited $TIME_FRAME!"
            exit
        fi
}

function stuck_statesync()
{
    # get prefixes seen
    # but ignore requests from other nodes
    IFS=' '
    PREFIXES=$(cat $INPUT_FILE | grep  "StateSyncRequest" | grep "sending request" | perl -ne 'print "$1, $2\n" if /prefix: (\d+).+(from: \d+, until: \d+)/')
    # only get the prefixes that appear more than once or twice
    COUNTS=$(echo $PREFIXES | sort | uniq -c | egrep -v ' 1 | 2 | 3 ' | wc -l)
    if [ $COUNTS -gt 0 ];
    then
        print_error "❌ Seeing multiple StateSyncRequest entries for the same prefix. StateSyncing appears stuck"
        echo -e "  ${DIM}→ maybe you need a reset + snapshot?${RESET}"
    fi
}
function statesync()
{
    if cat $INPUT_FILE | grep -qi StateSync;
    then
        if cat $INPUT_FILE | grep -q "done db statesync";
        then
            print_success "✅ Completed DB Statesync!"
            return 0
        fi

        if cat $INPUT_FILE | grep "StateSyncRequest" | grep -q "received statesync request";
        then
            print_success "✅ Currently receiving state sync requests from other nodes!"
        fi

        if cat $INPUT_FILE | grep -q "StateSyncResponse";
        then
            print_success "✅ Currently getting state sync responses!"
            if cat $INPUT_FILE | grep -qi "applying statesync response";
            then
                # we set the global state as it's used by other functions
                # later on in the checks
                GLOBAL_STATE_SYNC_IN_PROGRESS=true
                print_success "✅ Seeing statesync applying responses aka nodes are responding to our statesync requests!"

                print_info "Currently applying state sync responses from following servicers (showing last 3 requests)..."
                cat $INPUT_FILE | grep "StateSyncResponse" | grep "applying" | perl -ne 'print "\t$1\n" if /from":"(.+?)"/' | tail -3 | is_override | add_validator_names
                grep prefix $INPUT_FILE | perl -ne 'print "  Most recent statesync prefix: $1 of 255\n" if /prefix: (\d+)/' | sort | tail -1
                return 0
            fi
        fi

        # if we don't see state sync responses BUT we are seeing requests
        # then check for multiple prefixes
        if cat $INPUT_FILE | grep "StateSyncRequest" | grep -q "sending request";
        then
            print_info "Currently making state sync requests to below servicers (showing last 3 requests)..."
            cat $INPUT_FILE | grep "StateSyncRequest" | grep "sending request" | perl -ne 'print "\t$1\n" if /servicer":"(.+?)"/' | tail -3 | is_override | add_validator_names
            stuck_statesync
        fi
    else
        echo -e "${DIM}No StateSync messages.${RESET}"
    fi
}

function raptorcast()
{
    if cat $INPUT_FILE | grep -q "RaptorCast Broadcast v2v message";
	then
		print_info "RaptorCast: Broadcast going out..."
	fi
    if cat $INPUT_FILE | grep -q "confirm.*group";
	then
		print_success "✅ RaptorCast: Confirming group join!"
	fi

    # check if we've sent pings
    if cat $INPUT_FILE | grep "peer_discovery" | grep -q "sending ping request";
	then
		print_info "RaptorCast: sending ping request..."

        # if we sent a ping, check for a pong
        if cat $INPUT_FILE | grep "peer_discovery" | grep -q "handling pong response";
        then
            print_success "✅ RaptorCast: Handling pong response!"
        elif cat $INPUT_FILE | grep -q "peer_discovery";
        then
            print_warning "🟡 RaptorCast: Pings sent but no pong responses detected $TIME_FRAME!"
        fi
        if cat $INPUT_FILE | grep "peer_discovery" | grep -q "ping timeout";
        then
            print_warning "RaptorCast: Seeing ping timeouts when trying to connect to the below:"
            cat $INPUT_FILE | grep "peer_discovery" | grep "ping timeout" | perl -ne 'print "\t$1\n" if /to":"(.+?)"/' | sort -u | is_override | add_validator_names
        fi
    else
		echo -e "${DIM}RaptorCast: No ping requests seen $TIME_FRAME...${RESET}"
    fi
}

function blocksync()
{
    # Check for blocksync override peers in node.toml
    if [ -f "$NODE_TOML" ]; then
        # Display if file is not empty
        if [ -s "$OVERRIDE_FILE" ]; then
            print_info "BlockSync override peers configured:"
            cat "$OVERRIDE_FILE" | add_validator_names | while read -r peer; do
                echo -e "  ${CYAN}→${RESET} $peer"
            done
        else
            echo -e "${DIM}ZERO BlockSync overrides detected.${RESET}"
        fi
    else
        echo -e "${DIM}$NODE_TOML not present so can't determine if BlockSync overrides exist.${RESET}"
    fi
    if cat $INPUT_FILE | grep -qi BlockSync;
    then
        print_success "✅ BlockSync messages $TIME_FRAME..."
        if cat $INPUT_FILE | grep -i BlockSync | grep -qi "header request timed out";
        then
            print_warning "🟡 BlockSync timeout messages from below (last 3)..."
            cat $INPUT_FILE | grep blocksync | grep -i "header request timed out" | perl -ne 'print "\t$1\n" if /previous_to":"(.+?)"/' | tail -3 | is_override | add_validator_names
        fi
        if cat $INPUT_FILE | grep -i BlockSync | grep -qi "headers response not available";
        then
            print_warning "🟡 BlockSync headers response not available from below (last 3)..."
            cat $INPUT_FILE | grep -i blocksync | grep -i "headers response not" | perl -ne 'print "\t$1\n" if /sender":"(.+?)"/' | sed 's/None/Internal Ledger on this node/' | tail -3 | is_override | add_validator_names
        fi
    else
        echo -e "${DIM}No BlockSync messages.${RESET}"
    fi

}

function version_check()
{
    print_header "📦 VERSION INFORMATION"
    echo -e "${CYAN}APT Package:${RESET}"
    if PKG_INFO=$(dpkg -l 2>/dev/null | grep monad | tr -s " "); then
        echo "$PKG_INFO" | while IFS= read -r line || [ -n "$line" ]; do
            printf "  %b%s%b\n" "$DIM" "$line" "$RESET"
        done
    else
        echo -e "  ${DIM}Not installed${RESET}"
    fi

    # Check if curl is installed
    if ! command -v curl &> /dev/null; then
        echo -e "${CYAN}RPC Version:${RESET} ${YELLOW}curl not installed${RESET}"
        return 1
    fi

    echo -e "${CYAN}RPC Version:${RESET}"
    local rpc_response=$(curl -s http://localhost:8080 -X POST -H "Content-Type: application/json" \
      --data '{"jsonrpc":"2.0","method":"web3_clientVersion","params":[],"id":1}' 2>/dev/null)
    if [ -n "$rpc_response" ]; then
        echo -e "  ${DIM}$rpc_response${RESET}"
    else
        echo -e "  ${YELLOW}RPC not responding${RESET}"
    fi
    echo ""
}
